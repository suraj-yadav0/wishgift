generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  username      String   @unique
  email         String   @unique
  passwordHash  String
  bio           String?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  wishlists     Wishlist[]
  following     Follow[]  @relation("Following")
  followers     Follow[]  @relation("Follower")
  giftReservations GiftReservation[]
}

model Wishlist {
  id          String   @id @default(cuid())
  name        String
  description String?
  coverImage  String?
  isPublic    Boolean  @default(true)
  occasion    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       WishlistItem[]
}

model WishlistItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  price       Float?
  currency    String   @default("USD")
  productUrl  String?
  priority    Int      @default(0)
  quantity    Int      @default(1)
  isPurchased Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wishlistId  String
  wishlist    Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  reservations GiftReservation[]
}

model GiftReservation {
  id            String   @id @default(cuid())
  message       String?
  quantity      Int      @default(1)
  isAnonymous   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wishlistItemId String
  wishlistItem  WishlistItem @relation(fields: [wishlistItemId], references: [id], onDelete: Cascade)

  @@unique([userId, wishlistItemId])
}

model Follow {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId  String
  following    User     @relation("Follower", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}